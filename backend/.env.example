# ============================================================
#  DocuPulse AI — Backend Environment Configuration
# ============================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The application runs fully offline without any API keys.
# Adding a Gemini key enables higher-quality AI summarization.
# ============================================================

# -----------------------------------------------------------
# Google Gemini API Key (Optional — enables AI summarization)
# -----------------------------------------------------------
# Get a free key at: https://aistudio.google.com/app/apikey
# Used for: abstractive summarization via gemini-2.5-flash
#           document Q&A with grounded context
# Leave blank to use the built-in offline NLP engine instead.
GEMINI_API_KEY=

# -----------------------------------------------------------
# Tesseract OCR (System-level install — not a Python package)
# -----------------------------------------------------------
# Required only for image file OCR (PNG, JPG, scanned PDFs).
# Download installer: https://github.com/UB-Mannheim/tesseract/wiki
# Default Windows paths are auto-detected by extractor.py.
#
# If installed in a non-standard path, set it here:
# TESSERACT_CMD=C:\path\to\tesseract.exe

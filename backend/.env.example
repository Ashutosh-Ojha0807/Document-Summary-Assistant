# ============================================================
#  TalonAI — Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The app runs fully offline without any keys.
# Each key below unlocks a better extraction / AI engine.
# ============================================================


# ──────────────────────────────────────────────────────────────
# 1. Google Gemini API Key  (Optional — AI summarization)
# ──────────────────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
# Enables:  abstractive summarization via gemini-2.5-flash
#           document Q&A with grounded context
# Without:  built-in offline TextRank NLP engine is used instead
GEMINI_API_KEY=


# ──────────────────────────────────────────────────────────────
# 2. LLMWhisperer API Key  (Optional — best PDF extraction)
# ──────────────────────────────────────────────────────────────
# Get a free key at: https://unstract.com/llmwhisperer/
# Free tier: 100 pages / month (no credit card required)
# Enables:  layout-preserving PDF-to-text conversion
#           proper table structure extraction from PDFs
#           OCR of scanned / image-based PDFs via cloud
# Without:  pdfplumber + pypdf used instead
#           scanned PDFs return a stub message
LLMWHISPERER_API_KEY=


# ──────────────────────────────────────────────────────────────
# 3. Tesseract OCR  (System binary — not a Python package)
# ──────────────────────────────────────────────────────────────
# Only needed if PP-OCRv6 tiny is not available (e.g. import error).
# Windows installer: https://github.com/UB-Mannheim/tesseract/wiki
# Install to default path (C:\Program Files\Tesseract-OCR\) —
# extractor.py auto-detects it. No env var needed.
#
# Linux / Docker: installed automatically via apt-get in Dockerfile.
#
# Uncomment and set only if installed to a non-standard path:
# TESSERACT_CMD=C:\CustomPath\Tesseract-OCR\tesseract.exe


# ──────────────────────────────────────────────────────────────
# 4. PP-OCRv6 tiny  (No key required — auto-downloaded)
# ──────────────────────────────────────────────────────────────
# PP-OCRv6 tiny (1.5M params) is installed via pip (paddleocr==3.7.0).
# Model weights are downloaded from HuggingFace on first use (~20 MB).
# No API key needed. Works offline after the first run.
#
# Language: defaults to English ("en").
# To switch to multilingual OCR (49 languages including Chinese,
# Japanese, Arabic, Hindi, French, Spanish, Russian, etc.),
# edit this line in backend/services/extractor.py:
#   _PADDLEOCR_LANG = "multilingual"
# Valid values: "en", "multilingual", "ch", "japan", "arabic", "french", etc.


# ──────────────────────────────────────────────────────────────
# 5. CORS  (Production — scope to your frontend URL)
# ──────────────────────────────────────────────────────────────
# Leave as * for local dev. In production set to your exact frontend URL:
# ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=*
